272010004},{"x":1220.8867018603974,"y":662.9018150014202},{"x":654.7833396898822,"y":686.0766345346019}],"G":[1.3506227282646943,0.04105996273542,305.84218256598274,0.05195876321499323,1.305261081552189,325.6019801280413,0.0001504454111436497,-9.70384373750226e-7,1],"wall":{"x0":269.1381537417105,"y0":-121.33846290277381,"w":504.62303097353407,"h":407.93202401756207},"tiltDeg":1.0047982764811256}],"hands":[],"transcript":"okay here's another one not in my home this one is 57 centimeters wide when i i measured it that's it there pretty much from straight on","options":[{"stockCm":120,"cutToMm":950,"cutPerEndMm":125,"overhangEachSideMm":174.24994011933785,"twoPiece":false,"brackets":2,"fit":"ideal","overallWithFinialsMm":1130,"note":"cut 12.5 cm off each end"}],"timingsMs":{"uploadMs":4294,"handsMs":9640,"measureMs":9640,"windowOutline":2,"framesWithHandsSetAside":0,"handsTimedOut":1,"spanMs":35888,"draftMs":44059,"totalMs":91351},"models":["sam-3.1","sam-3.1 (video tracking: hands)","muse-voice-transcribe-1.0","muse-spark-1.3 (which edges)","muse-spark-1.3"],"widthMm":601.5001197613243,"heightMm":null,"spreadMm":4.218176230374979,"framesUsed":8,"heroFrame":24,"span":{"adopted":true,"widthMm":601.5001197613243,"frameWidthMm":488.4168298107887,"why":"recess opening at wall face","left":"A","right":"D","edges":[{"xMm":214.2938076442671,"strength":12.639738841035411,"label":"A"},{"xMm":261.1330735099319,"strength":0,"label":"B","measured":true},{"xMm":749.5499033207207,"strength":0,"label":"C","measured":true},{"xMm":815.7939274055914,"strength":40.0566007610326,"label":"D"}],"votes":"3 of 3"},"spreadFrom":"the opening, across the frames that agreed","draft":{"curtainType":"unknown","chosenStockCm":120,"diameterMm":35,"reply":"Thanks for the video. My tool measured 60.2 cm for the opening in the wall around the window, and you measured 57 cm for the same area.\n\nFor 60.2 cm I would send the 120 cm pole to cut to 95 cm, taking 12.5 cm off each end. The alternative for 57 cm would be the same 120 cm pole cut to 92 cm, taking 14 cm off each end. Please allow for the finials as they add 9 cm at each end.\n\nYou would trim it at home with a fine-tooth saw and my instructions are included. Could you let me know which edges your 57 cm runs between, as cut poles cannot be returned.\n\nBest wishes, Rob","questions":["Could you let me know which edges your 57 cm runs between, for example the recess opening around a set-back window where the pole would span the opening, so I know which size to send?"],"ranOn":"muse-spark-1.3"},"fps":3,"blinds":{"options":[{"fit":"outside, standard","widthMm":700,"dropMm":null,"overlapEachSideMm":50,"note":"covers the opening with a little to spare each side"},{"fit":"outside, blackout","widthMm":760,"dropMm":null,"overlapEachSideMm":80,"note":"wider overlap so less light gets round the sides"},{"fit":"inside the recess","widthMm":590,"dropMm":null,"overlapEachSideMm":0,"note":"a guide only: check the recess width with a tape before ordering, as an inside blind has to be exact"}],"draft":{"reply":"Thanks for the clip!\n\nI measured the recess opening on the wall at 60.2 cm.\n\nTo order: outside standard 70 cm wide with 5 cm overlap each side. Outside blackout 76 cm wide with 8 cm overlap each side. Inside the recess 59 cm wide.\n\nPlease treat 59 cm as a guide only and check the recess width with a tape before ordering it, because a measurement from a video can be a few centimetres out and a blind inside a recess has to be exact.\n\nI could not get the drop from the clip, so please measure the height from the top bracket position to the bottom edge you want covered?\n\nBest wishes","questions":["Could you please measure the height from the top bracket position to the bottom edge you want covered?","For the inside fit, could you confirm the recess width measured with a tape?"]},"model":"muse-spark-1.3"}}