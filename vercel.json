{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/run.ts": {
      "maxDuration": 120,
      "memory": 1769,
      "includeFiles": "samples/*/{meta.json,clip.mp4,audio.wav,frames/*.jpg}"
    },
    "api/render.ts": {
      "maxDuration": 90,
      "memory": 1769,
      "includeFiles": "public/samples/*/{run.json,hero.jpg}"
    },
    "api/send.ts": {
      "maxDuration": 15
    },
    "api/status.ts": {
      "maxDuration": 10
    },
    "api/upload.ts": {
      "maxDuration": 120,
      "memory": 1769
    }
  }
}